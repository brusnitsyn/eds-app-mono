APP_NAME="Электронный реестр сертификатов и персонала"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Yakutsk"
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aokb_eds_app
DB_USERNAME=root
DB_PASSWORD=

MIS_DB_HOST=
MIS_DB_PORT=
MIS_DB_DATABASE=
MIS_DB_USERNAME=
MIS_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=typesense
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Меры защиты ИСПДн (ФСТЭК №21, УЗ-1/К1) — см. config/security.php
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_PASSWORD_MIXED_CASE=true
SECURITY_PASSWORD_NUMBERS=true
SECURITY_PASSWORD_SYMBOLS=true
SECURITY_PASSWORD_UNCOMPROMISED=false
SECURITY_PASSWORD_HISTORY=5
SECURITY_PASSWORD_MAX_AGE_DAYS=90

SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DECAY_MINUTES=30

# Включать только после того, как все пользователи настроят 2FA в профиле.
SECURITY_MFA_REQUIRED=false
SECURITY_MFA_RECOVERY_CODES=8

# laravel | gost (gost требует подключения сертифицированного СКЗИ, см. docs)
SECURITY_PDN_CIPHER_DRIVER=laravel
# Сгенерировать: php artisan key:generate --show
SECURITY_PSEUDONYM_KEY=
SECURITY_GOST_BINARY=/opt/cprocsp/bin/amd64/csptest
SECURITY_GOST_CONTAINER=

SECURITY_HSTS_MAX_AGE=31536000

SECURITY_IP_WHITELIST_ENABLED=false
SECURITY_IP_WHITELIST=

# Журнал аудита (ФСТЭК №21, меры РСБ.*) — см. config/audit.php
AUDIT_DB_CONNECTION=audit
AUDIT_TABLE=audit_log
AUDIT_DB_CONNECTION_DRIVER=sqlite
# Не задавать пустым значением — пустая строка не откатывается на дефолт
# database_path('audit.sqlite'), оставляйте переменную закомментированной,
# либо укажите абсолютный путь/реквизиты отдельной БД для прода.
# AUDIT_DB_DATABASE=
# Сгенерировать: php artisan key:generate --show
AUDIT_HMAC_KEY=
AUDIT_HASH_CHAIN=true
AUDIT_RETENTION_DAYS=1095
AUDIT_SIEM_ENABLED=false
AUDIT_SIEM_CHANNEL=siem
AUDIT_DISK_ALERT_THRESHOLD=80
